{
    "name": "ironshashwat/laravel-invoice-autofill",
    "description": "Instant client-side PDF invoice parsing and form auto-fill for Laravel applications.",
    "keywords": [
        "laravel",
        "invoice",
        "pdf",
        "autofill",
        "ocr",
        "pdf-parser",
        "blade"
    ],
    "homepage": "https://github.com/ironshashwat/laravel-invoice-autofill",
    "license": "MIT",
    "authors": [
        {
            "name": "Shashwat Mishra",
            "email": "shashwatmishra2608@gmail.com",
            "homepage": "https://github.com/ironshashwat",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Ironshashwat\\InvoiceAutofill\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ironshashwat\\InvoiceAutofill\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ironshashwat\\InvoiceAutofill\\InvoiceAutofillServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
